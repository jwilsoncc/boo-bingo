<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Boo Bingo – Services on Hold | Care Coordinator Training</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Creepster&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#17121f; --panel:#221a33; --panel2:#2b2142; --line:#3b2f57;
  --text:#f1ecfa; --muted:#b9aed0; --orange:#ffa23a; --orange2:#ff7a2f;
  --mint:#7ef0c8; --warn:#ffd36b;
  --display:'Creepster','Impact','Arial Black',sans-serif;
  --body:system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--body);line-height:1.5;padding:0 0 48px}
.wrap{max-width:1200px;margin:0 auto;padding:0 20px}
h1,h2{font-family:var(--display);font-weight:400;letter-spacing:.04em;margin:0}
header{display:flex;gap:24px;justify-content:space-between;align-items:flex-start;padding:24px 0 20px;flex-wrap:wrap}
h1{font-size:clamp(3rem,8vw,5.5rem);line-height:1;color:var(--orange);text-shadow:0 0 22px rgba(255,162,58,.45)}
.sub{color:var(--mint);font-weight:700;letter-spacing:.14em;font-size:.85rem;margin-top:6px}
.draft{max-width:520px;border:1px dashed var(--warn);border-radius:10px;padding:12px 16px;font-size:.88rem;color:var(--warn);background:rgba(255,211,107,.05)}
.draft strong{display:block;margin-bottom:2px;letter-spacing:.06em}
main{max-width:760px;margin:0 auto}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:22px;padding:22px}
h2{font-size:2rem;color:var(--mint)}
.cauldron-box{display:flex;flex-direction:column;align-items:center}
svg.cauldron{width:min(100%,320px);height:auto;overflow:visible}
.bubble{fill:#7ef0c8;opacity:.8}
.stirring .stick{animation:stir .9s ease-in-out 2}
.stirring .bubble{animation:rise 1.8s ease-out 1}
@keyframes stir{0%,100%{transform:rotate(0)}25%{transform:rotate(-9deg)}75%{transform:rotate(9deg)}}
@keyframes rise{0%{transform:translateY(0);opacity:.9}100%{transform:translateY(-40px);opacity:0}}
.stick{transform-origin:350px 300px;transform-box:view-box}
.controls{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin:6px 0 16px}
button{font:inherit;cursor:pointer;border-radius:999px;border:1px solid var(--line);background:var(--panel2);color:var(--text);padding:12px 20px;font-weight:700}
button:hover:not(:disabled){border-color:var(--mint)}
button:disabled{opacity:.45;cursor:not-allowed}
button:focus-visible,.reason:focus-visible{outline:3px solid var(--mint);outline-offset:2px}
button.primary{background:linear-gradient(180deg,var(--orange),var(--orange2));color:#2a1500;font-size:1.15rem;padding:15px 34px;border:0;box-shadow:0 6px 22px rgba(255,122,47,.35)}
button.ghost{background:transparent;color:var(--muted)}
.call{width:100%;background:#120d1b;border:1px solid var(--line);border-radius:16px;padding:18px 20px;min-height:200px}
.call-head{display:flex;justify-content:space-between;gap:10px;font-size:.8rem;color:var(--muted);letter-spacing:.08em;font-weight:700}
.call-head .count{color:var(--mint)}
.scenario{font-size:clamp(1.3rem,3vw,1.9rem);margin:12px 0}
.revealed{border-top:1px solid var(--line);padding-top:12px;margin-top:8px}
.revealed .tag{color:var(--muted);font-size:.85rem}
.revealed .answer{font-family:var(--display);font-size:1.9rem;color:var(--orange);letter-spacing:.04em}
.bank-intro{color:var(--muted);font-size:.92rem;margin:6px 0 16px}
.bank{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.reason{font:inherit;text-align:left;border-radius:12px;padding:14px;background:#120d1b;border:1px solid var(--line);color:var(--text);font-weight:400;min-height:72px}
.reason[aria-disabled="true"]{cursor:default}
.reason.lit{background:rgba(126,240,200,.12);border-color:var(--mint);box-shadow:0 0 14px rgba(126,240,200,.25);font-weight:700;cursor:pointer}
.note{color:var(--muted);font-size:.85rem;margin-top:14px}
details.how{margin-top:16px;color:var(--muted);font-size:.92rem}
details.how summary{cursor:pointer;color:var(--text);font-weight:700}
details.how ol{margin:8px 0 0 20px;padding:0}
.key{margin-top:20px;background:var(--panel);border:1px solid var(--line);border-radius:22px;padding:22px}
.key-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;flex-wrap:wrap}
.key-head p{color:var(--muted);margin:6px 0 0;max-width:760px;font-size:.92rem}
.key-list{display:grid;gap:14px;margin-top:18px}
.entry{background:#120d1b;border:1px solid var(--line);border-radius:14px;padding:16px 18px}
.entry.focus{border-color:var(--orange);box-shadow:0 0 0 2px rgba(255,162,58,.3)}
.entry h3{margin:0 0 6px;color:var(--orange);font-size:1.1rem}
.entry h4{margin:12px 0 4px;color:var(--mint);font-size:.9rem}
.entry ul{margin:0;padding-left:20px}
.entry p{margin:0}
.empty{color:var(--muted)}
footer{color:var(--muted);font-size:.85rem;max-width:760px;margin-top:22px}
[hidden]{display:none!important}
@media(prefers-reduced-motion:reduce){.stirring .stick,.stirring .bubble{animation:none}}
</style>
</head>
<body>
<div class="wrap">
<header>
  <div>
    <h1>Boo Bingo</h1>
    <div class="sub">SERVICES ON HOLD · CARE COORDINATOR TRAINING</div>
  </div>
  <div class="draft"><strong>DRAFT FOR REVIEW</strong>These hold scenarios and answer key were drafted for training. A supervisor or compliance reviewer must confirm them against company policy before use.</div>
</header>

<main>
  <section class="panel cauldron-box" aria-label="Scenario caller">
    <svg class="cauldron" id="cauldron" viewBox="0 0 700 560" role="img" aria-label="Bubbling cauldron">
      <defs>
        <radialGradient id="glow" cx="50%" cy="40%" r="60%"><stop offset="0" stop-color="#7ef0c8" stop-opacity=".35"/><stop offset="1" stop-color="#7ef0c8" stop-opacity="0"/></radialGradient>
        <linearGradient id="pot" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2a2433"/><stop offset="1" stop-color="#0d0a12"/></linearGradient>
        <linearGradient id="brew" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#b8ffe6"/><stop offset="1" stop-color="#2fc9a0"/></linearGradient>
        <linearGradient id="fire" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffb347"/><stop offset="1" stop-color="#ff5a2a"/></linearGradient>
      </defs>
      <ellipse cx="350" cy="260" rx="300" ry="220" fill="url(#glow)"/>
      <path d="M255 490 Q300 420 350 420 Q400 420 445 490 Z" fill="url(#fire)"/>
      <path d="M300 490 Q330 450 350 450 Q372 452 400 490 Z" fill="#ffd27a"/>
      <path d="M160 470 L130 540 L170 540 L215 480Z M540 470 L570 540 L530 540 L485 480Z" fill="#0d0a12"/>
      <path d="M95 330 Q85 300 120 305 L120 335 Z M605 330 Q615 300 580 305 L580 335 Z" fill="none" stroke="#1b1524" stroke-width="16"/>
      <path d="M110 300 Q110 470 350 480 Q590 470 590 300 Z" fill="url(#pot)"/>
      <path d="M150 340 Q160 430 250 455" fill="none" stroke="#4a4160" stroke-width="7" stroke-linecap="round" opacity=".7"/>
      <ellipse cx="350" cy="300" rx="250" ry="52" fill="#16111d" stroke="#2a2433" stroke-width="10"/>
      <ellipse cx="350" cy="300" rx="228" ry="38" fill="url(#brew)"/>
      <g class="stick"><rect x="338" y="120" width="22" height="190" rx="9" fill="#8a5a33" transform="rotate(8 350 300)"/><ellipse cx="350" cy="305" rx="24" ry="9" fill="#8a5a33"/></g>
      <circle class="bubble" cx="300" cy="250" r="14"/><circle class="bubble" cx="410" cy="235" r="10"/><circle class="bubble" cx="380" cy="205" r="16"/><circle class="bubble" cx="250" cy="200" r="8"/><circle class="bubble" cx="440" cy="190" r="6"/>
    </svg>

    <div class="controls">
      <button class="primary" id="stir">Stir the Cauldron</button>
      <button class="ghost" id="undo" disabled>Undo last call</button>
      <button id="reset">New game</button>
    </div>

    <div class="call" aria-live="polite">
      <div class="call-head"><span id="stateLabel">READY WHEN YOU ARE</span><span class="count" id="count">0 OF 15 CALLED</span></div>
      <p class="scenario" id="scenario">Stir the cauldron to call the first scenario. Read it aloud, and players mark the hold reason it matches if it is on their card.</p>
      <div class="revealed" id="revealBox" hidden>
        <div class="tag">Hold reason</div>
        <div class="answer" id="answer"></div>
      </div>
      <div class="controls" style="margin:12px 0 0;justify-content:flex-start">
        <button id="reveal" hidden>Reveal hold reason</button>
      </div>
    </div>

  </section>

</main>


<footer>All scenarios are fictional. No real member names or identifying information are used. Every timeframe, form name, and system step must follow your company procedures; where this key says "confirm with company policy," get the answer from your supervisor or compliance lead before training.</footer>
</div>

<script>
/* ------------------------------------------------------------------
   EDIT HERE. Each item = one hold reason, one scenario, one trainer key.
   `reason`   shows in the word bank and as the answer.
   `scenario` is read aloud by the trainer.
   (`why` and `steps` are kept for reference but not shown.)
------------------------------------------------------------------- */
const CONFIRM = "Confirm with company policy.";
const HOLDS = [
  { reason:"Children living in home of SFC caregiver",
    scenario:"During a home visit, a care coordinator learns that several children now live full-time in the home of the member's SFC caregiver. This was not known before.",
    why:"A change in who lives in the caregiver's home can affect whether the SFC arrangement still meets program requirements.",
    steps:["Document who lives in the home and when it changed.","Notify your supervisor and the right reviewer.","What has to be reviewed before services can restart? "+CONFIRM] },
  { reason:"Member's LOC has expired",
    scenario:"A member's level of care determination ran out last week, and there is no renewal on file.",
    why:"Services generally depend on a current level of care, so an expired LOC is a reason to hold until it is renewed.",
    steps:["Check the LOC end date in the system.","Who starts the renewal, and how fast? "+CONFIRM,"Tell the member and provider what to expect."] },
  { reason:"Member requested hold",
    scenario:"A member calls and says they do not want any services right now and asks their care coordinator to put everything on hold.",
    why:"The member has the right to ask for a pause in their services.",
    steps:["Ask why, and offer help with any concern.","How is the request documented? "+CONFIRM,"Agree on when you will check back in."] },
  { reason:"Member has provider concerns",
    scenario:"A member tells their care coordinator that their provider shows up late, leaves early, and makes them uncomfortable. They want services paused until it is sorted out.",
    why:"Concerns about a provider can be a reason to pause services while the issue is looked into or the member chooses a new provider.",
    steps:["Listen and document the concern in the member's words.","Does this need to be reported or escalated? "+CONFIRM,"Offer options such as a different provider."] },
  { reason:"Member is hard to reach",
    scenario:"A care coordinator has called, texted, and mailed a letter to a member over three weeks and has not received any response.",
    why:"If a member cannot be reached after repeated attempts, services may need to pause until contact is made.",
    steps:["Document every attempt with date and method.","How many attempts are required, and over what timeframe? "+CONFIRM,"Who else can you try, such as an alternate contact?"] },
  { reason:"Moving from PSSX to SFC (or vice versa)",
    scenario:"A member's services are changing from PSSX to SFC, and the change has not been finalized, so the current service has to pause.",
    why:"A change in service type needs to be completed before the new service can begin, which can leave a gap that requires a hold on the old one.",
    steps:["Confirm the effective date of the change.","What paperwork and approvals are still open? "+CONFIRM,"Tell the member and caregiver what the gap means for them."] },
  { reason:"Member missing or refusing home visit",
    scenario:"A care coordinator goes to the home for a scheduled visit and no one answers. Later the member says they do not want anyone coming to the house.",
    why:"A care coordinator cannot do required visits if the member is missing or refuses them, which may require a hold.",
    steps:["Document the attempt and what the member said.","What are the required visit timeframes? "+CONFIRM,"Explain what the member's refusal means for their services."] },
  { reason:"Member admitted to the hospital",
    scenario:"A family member calls to say the member was admitted to the hospital last night and is expected to stay several days.",
    why:"Home services cannot be delivered while the member is an inpatient, so services are held for the stay.",
    steps:["Confirm admission date and facility.","Who tells the provider, and when? "+CONFIRM,"Start planning for the member's return home."] },
  { reason:"Member's caregiver has not reported for work",
    scenario:"A member's caregiver has not shown up for scheduled shifts for several days, and no one is providing the member's care.",
    why:"If the caregiver is not providing the service, there may be no service to bill or deliver, and the member's needs still have to be met.",
    steps:["Make sure the member is safe right now.","Contact the caregiver or provider agency to find out why.","What backup options are there? "+CONFIRM] },
  { reason:"Member's Medicaid is inactive",
    scenario:"While checking eligibility, a care coordinator sees that a member's Medicaid shows as inactive as of the first of the month.",
    why:"Services depend on active Medicaid, so inactive coverage is a reason to hold.",
    steps:["Verify the status and the date it changed.","Help the member find out what they need to do to restore coverage.","What happens to services already delivered? "+CONFIRM] },
  { reason:"Member missed several scheduled visits",
    scenario:"A member has missed three scheduled visits in a row and has given no reason.",
    why:"Repeated missed visits can mean the member's needs or situation have changed, and may lead to a hold.",
    steps:["Reach out and ask what is going on.","How many missed visits trigger a hold? "+CONFIRM,"Look for barriers such as transportation or health."] },
  { reason:"Provider is unable to contact member",
    scenario:"A provider reports that they have gone to the member's door and called many times, and no one answers.",
    why:"The provider cannot deliver services to someone they cannot reach, so the care coordinator needs to find the member.",
    steps:["Contact the member and any alternate contacts.","Do you need to request a welfare check? "+CONFIRM,"Document what the provider reported."] },
  { reason:"Member is traveling (international or out of state)",
    scenario:"A member tells their care coordinator they are going to visit relatives overseas for two months.",
    why:"Services are generally for the member in their home area, so extended travel is a reason to hold.",
    steps:["Get the departure and expected return dates.","What are the rules for travel outside the state or country? "+CONFIRM,"Plan how services restart when they return."] },
  { reason:"CC observed safety concerns",
    scenario:"During a home visit, a care coordinator sees something that makes them worry about the safety of the member or the caregiver.",
    why:"If the home or situation is unsafe, services may need to pause while the concern is addressed.",
    steps:["Make sure everyone is safe first and act on immediate danger.","What must be reported, and to whom? "+CONFIRM,"Document what you observed, without opinions."] },
  { reason:"Member is in jail",
    scenario:"A care coordinator learns from the member's family that the member was arrested and is being held in jail.",
    why:"A member who is incarcerated cannot receive home services, so services are held.",
    steps:["Confirm the situation with a reliable source.","Who needs to be notified? "+CONFIRM,"What is needed to restart services after release?"] }
];
/* ------------------------------------------------------------------ */

const $ = id => document.getElementById(id);
let called = [];      // indices in call order
let revealed = new Set();

function current(){ return called.length ? called[called.length-1] : null; }

function render(){
  const n = called.length, c = current();
  $('count').textContent = `${n} OF ${HOLDS.length} CALLED`;
  $('undo').disabled = n===0;
  $('stir').disabled = n===HOLDS.length;
  if(c===null){
    $('stateLabel').textContent='READY WHEN YOU ARE';
    $('scenario').textContent='Stir the cauldron to call the first scenario. Read it aloud, and players mark the hold reason it matches if it is on their card.';
    $('reveal').hidden=true; $('revealBox').hidden=true;
  } else {
    $('stateLabel').textContent=`SCENARIO ${n}`;
    $('scenario').textContent=HOLDS[c].scenario;
    const isRev = revealed.has(c);
    $('reveal').hidden=isRev; $('revealBox').hidden=!isRev;
    if(isRev) $('answer').textContent=HOLDS[c].reason;
  }
  if(n===HOLDS.length && revealed.has(c)) $('stateLabel').textContent='ALL SCENARIOS CALLED';
}

$('stir').addEventListener('click',()=>{
  // finish the previous call so it doesn't get skipped
  const c=current(); if(c!==null) revealed.add(c);
  const left=HOLDS.map((_,i)=>i).filter(i=>!called.includes(i));
  if(!left.length) return;
  const pick=left[Math.floor(Math.random()*left.length)];
  called.push(pick);
  const svg=$('cauldron'); svg.classList.remove('stirring'); void svg.getBoundingClientRect(); svg.classList.add('stirring');
  render();
});
$('reveal').addEventListener('click',()=>{ revealed.add(current()); render(); });
$('undo').addEventListener('click',()=>{
  const c=called.pop();
  if(c!==undefined){
    revealed.delete(c);
    // the call before it stays revealed only if it was revealed before
  }
  render();
});
$('reset').addEventListener('click',()=>{
  if(called.length && !confirm('Start a new game? This clears all called scenarios.')) return;
  called=[]; revealed=new Set(); render();
});
render();
</script>
</body>
</html>
